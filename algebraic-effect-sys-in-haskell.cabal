  main-is: Framework/Generate.hs
  hs-source-dirs: sdk
  other-modules: Framework.Codegen.Handlers
  ghc-options: -main-is Framework.Generate
  build-depends:
      base >= 4.21 && < 5
    , filepath
    , process >= 1.6 && < 1.7
    , directory
    , ghc == 9.12.*
  default-language: Haskell2010
