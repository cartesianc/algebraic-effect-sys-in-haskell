cabal-version: 3.0
name: algebraic-effect-sys-in-haskell
version: 0.1.0.0
synopsis: Algebraic Effect Sys in Haskell
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
extra-source-files:
    README.md
    AGENTS.md
    hie.yaml
    docs/*.md
    sdk/Framework/Gen/Composition.hs
    demo/*/Handlers.hs
    demo/*/Generated/Assets.hs

source-repository head
  type: git
  location: https://github.com/cartesianc/algebraic-effect-sys-in-haskell.git

-- Shared runtime modules and dependencies; effect-codegen keeps its own compiler modules.
common runtime-program
  hs-source-dirs: demo, sdk
  other-modules:
      Framework.SDK
      Framework.Generated
      Framework.Program
      Framework.Recursion
      Framework.Language.AST
      Framework.Language.Handler
      Framework.Language.Registration
      Framework.Prototype
      Framework.Prototype.Types
      Framework.Prototype.Graph
      Framework.Prototype.Query
      Framework.Prototype.Validate
      Framework.Prototype.Structure
      Framework.Runtime
      Framework.Runtime.Protocol
      Framework.Runtime.Context
      Framework.Runtime.Binding
      Framework.Runtime.Scope
      Framework.Runtime.App
      Framework.Runtime.Frame
      Framework.Runtime.Identity
      Framework.Runtime.Graph
      Framework.Runtime.Session
      Framework.Runtime.Execution
  ghc-options: -threaded
  build-depends:
      base >= 4.21 && < 5
    , containers
    , deepseq
    , mtl >= 2.3 && < 2.4
    , filepath
    , process >= 1.6 && < 1.7
    , transformers >= 0.6 && < 0.7
  default-language: Haskell2010

executable crawler-demo
  import: runtime-program
  main-is: Crawler/Main.hs
  other-modules:
      Crawler.AST
      Crawler.Workflow.ParsePages
      Crawler.Workflow.PrintPages
      Crawler.Effects
      Crawler.Types
      Crawler.Generated.Effects
      Crawler.Generated.Program
      Crawler.Generated.Handlers
  ghc-options: -main-is Crawler.Main
  build-depends:
      directory
    , tagsoup >= 0.14.8 && < 0.15

executable file-demo
  import: runtime-program
  main-is: FileDemo/Main.hs
  other-modules:
      FileDemo.AST
      FileDemo.Workflow.OperateFile
      FileDemo.Effects
      FileDemo.Types
      FileDemo.Generated.Effects
      FileDemo.Generated.Program
      FileDemo.Generated.Handlers
  ghc-options: -main-is FileDemo.Main

executable open-files-demo
  import: runtime-program
  main-is: OpenFilesDemo/Main.hs
  other-modules:
      OpenFilesDemo.AST
      OpenFilesDemo.Workflow.HoldAndInspectFiles
      OpenFilesDemo.Workflow.FinishInspection
      OpenFilesDemo.Effects
      OpenFilesDemo.Types
      OpenFilesDemo.Generated.Effects
      OpenFilesDemo.Generated.Program
      OpenFilesDemo.Generated.Handlers
  ghc-options: -main-is OpenFilesDemo.Main
  build-depends:
      directory

executable scope-reuse-demo
  import: runtime-program
  main-is: ScopeReuseDemo/Main.hs
  other-modules:
      ScopeReuseDemo.AST
      ScopeReuseDemo.Workflow.PrepareProbe
      ScopeReuseDemo.Workflow.WriteInParallel
      ScopeReuseDemo.Workflow.VerifyReuse
      ScopeReuseDemo.Effects
      ScopeReuseDemo.Types
      ScopeReuseDemo.Generated.Effects
      ScopeReuseDemo.Generated.Program
      ScopeReuseDemo.Generated.Handlers
  ghc-options: -main-is ScopeReuseDemo.Main
  build-depends:
      directory

executable scope-instances-demo
  import: runtime-program
  main-is: ScopeInstancesDemo/Main.hs
  other-modules:
      ScopeInstancesDemo.AST
      ScopeInstancesDemo.Workflow.PrepareFiles
      ScopeInstancesDemo.Workflow.CheckInstances
      ScopeInstancesDemo.Effects
      ScopeInstancesDemo.Types
      ScopeInstancesDemo.Generated.Effects
      ScopeInstancesDemo.Generated.Program
      ScopeInstancesDemo.Generated.Handlers
  ghc-options: -main-is ScopeInstancesDemo.Main
  build-depends:
      directory

executable stream-demo
  import: runtime-program
  main-is: StreamDemo/Main.hs
  other-modules:
      StreamDemo.AST
      StreamDemo.Workflow.Setup
      StreamDemo.Workflow.Monitor
      StreamDemo.Effects
      StreamDemo.Types
      StreamDemo.Generated.Effects
      StreamDemo.Generated.Program
      StreamDemo.Generated.Handlers
  ghc-options: -main-is StreamDemo.Main

executable lines-demo
  import: runtime-program
  main-is: LinesDemo/Main.hs
  other-modules:
      LinesDemo.AST
      LinesDemo.Effects
      LinesDemo.Types
      LinesDemo.Generated.Effects
      LinesDemo.Generated.Program
      LinesDemo.Generated.Handlers
  ghc-options: -main-is LinesDemo.Main

executable effect-codegen
  main-is: Framework/Gen/Main.hs
  hs-source-dirs: sdk
  other-modules:
      Framework.Gen
      Framework.Gen.Source
      Framework.Gen.Composition
      Framework.Gen.Emit.Types
      Framework.Gen.Names
      Framework.Gen.Shape
      Framework.Gen.Emit.Effects
      Framework.Gen.Emit.Handlers
      Framework.Gen.Emit.Program
      Framework.Gen.Emit.Prototype
      Framework.Gen.Assets
      Framework.Gen.Catalog
      Framework.Recursion
      Framework.Language.AST
      Framework.Language.Handler
      Framework.Language.Registration
      Framework.Prototype
      Framework.Prototype.Types
      Framework.Prototype.Graph
      Framework.Prototype.Query
      Framework.Prototype.Validate
  ghc-options: -main-is Framework.Gen.Main
  build-depends:
      base >= 4.21 && < 5
    , containers
    , deepseq
    , filepath
    , process >= 1.6 && < 1.7
    , directory
    , ghc == 9.12.*
    , mtl >= 2.3 && < 2.4
    , time
  default-language: Haskell2010
